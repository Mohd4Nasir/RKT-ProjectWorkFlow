# FILE: .env  (MODIFIED)
#
# Add these variables to your existing .env file.
# DO NOT commit this file to git — it contains environment-specific URLs.
# Use .env.example (without values) for documentation.
#
# ─── Keycloak ──────────────────────────────────────────────────────────────
#
# VITE_KEYCLOAK_URL
#   Base URL of your Keycloak server (no trailing slash).
#   Local dev:    http://localhost:8080
#   Production:   https://auth.yourcompany.com
#
vite.config.ts
VITE_KEYCLOAK_URL=http://192.168.0.61:8181
# VITE_KEYCLOAK_URL=http://rkt-lap-0071:8181
# VITE_KEYCLOAK_URL=http://192.168.0.61:8181

# VITE_KEYCLOAK_REALM
#   The realm name you created in the Keycloak Admin Console.
#   Example: if your realm is named "myapp", set this to "myapp".
#   The full token URL becomes:
#     {VITE_KEYCLOAK_URL}/realms/{VITE_KEYCLOAK_REALM}/protocol/openid-connect/token
#
VITE_KEYCLOAK_REALM=rkt

# VITE_KEYCLOAK_CLIENT_ID
#   The Client ID registered in your realm.
#   Must be a PUBLIC client (no secret) with:
#     - Standard Flow Enabled: ✅
#     - Direct Access Grants: ❌ (not needed for SPA)
#     - Valid Redirect URIs:  http://localhost:5173/*  (add production URL too)
#     - Web Origins:          http://localhost:5173    (for CORS)
#
VITE_KEYCLOAK_CLIENT_ID=project-tracker-frontend 

# ─── API ───────────────────────────────────────────────────────────────────
#
# Base URL for your backend API.
# axiosInstance uses this as the baseURL for all API requests.
# Can use a relative path ('/api') if you proxy via vite.config.ts.
#
VITE_API_BASE_URL=http://192.168.0.61:8080



